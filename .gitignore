__pycache__/
*.pyc

# Cheat Engine tables and live-memory-era scratch/debug output -- superseded
# by the save-file approach (FINDINGS.md Part 3), not needed to use anything
# in this repo, and not small.
*.CT
raw_flags_dump.json
region_dump.bin
region_dump.json
progression_snapshot.json
progression_snapshot_log.txt

# A huge raw strings dump from early exploration -- ~47MB, not something
# any tool here reads.
strings.txt

# Real save files -- these can contain account-identifying data
# (linked platform account IDs) and shouldn't be committed.
PROF_SAVE*
*.sav

# Third-party RTTI header dump shared privately on Discord (credit: Meteor)
# -- thousands of files, and not this project's to redistribute in bulk.
# Keep locally for reference; don't publish wholesale.
SDK/

# Community save sets (real save files without the PROF_SAVE name) and
# decoded save dumps -- the section keys can carry account-derived IDs.
0percent*/
decoded_check.json

# Local working copies of files that also live in runtime/
Claude outputs/
